{
  "expo": {
    "name": "MatchPoint",
    "slug": "sports-matchmaking",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0f0d",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f0d"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "MatchPoint · Encontrá con quién jugar",
      "shortName": "MatchPoint",
      "themeColor": "#0a0f0d",
      "backgroundColor": "#0a0f0d"
    },
    "plugins": ["expo-font"]
  }
}
